  COMMAND = cd /home/martina/rp_project/robot-programming-project/src/simple_robot/build && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build test: phony CMakeFiles/test.util


